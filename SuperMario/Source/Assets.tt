<#@ template language="C#" hostSpecific="true" #>
<#@ output extension=".cs" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Globalization" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text.RegularExpressions" #>

<#
	var sections = new[]
	{
		new AssetSection("Maps", "../Content/Levels", new[] { ".tmx" }),
		new AssetSection("Sprites", "../Content/Sprites", new[] { ".png", ".jpg", ".jpeg" }),
		new AssetSection("Sfx", "../Content/Sfx", new[] { ".wav" }),
		new AssetSection("Music", "../Content/Music", new[] { ".ogg" }),
	};
#>

namespace SuperMario
{
    /// <summary>
    /// class that contains the names of all runtime content files
    /// </summary>
    /// <remarks>
    /// Auto-generated from Assets.tt. Run the T4 custom tool after adding,
    /// removing, or renaming files under Content.
    /// </remarks>
    class Assets
    {
<#
	foreach (var section in sections)
		PrintSection(section);
#>
    }
}

<#+
	class AssetSection
	{
		public string ClassName;
		public string Folder;
		public HashSet<string> Extensions;

		public AssetSection(string className, string folder, IEnumerable<string> extensions)
		{
			ClassName = className;
			Folder = folder;
			Extensions = new HashSet<string>(extensions, StringComparer.OrdinalIgnoreCase);
		}
	}

	void PrintSection(AssetSection section)
	{
		WriteLine("\t\tpublic static class {0}", section.ClassName);
		WriteLine("\t\t{");

		var path = Host.ResolvePath(section.Folder);
		if (Directory.Exists(path))
		{
			foreach (var file in Directory.GetFiles(path).OrderBy(s => s))
			{
				var extension = Path.GetExtension(file);
				if (!section.Extensions.Contains(extension))
					continue;

				var name = GenerateConstantName(Path.GetFileNameWithoutExtension(file));
				var contentPath = ToContentPath(file);
				WriteLine("\t\t\tpublic const string {0} = @\"{1}\";", name, contentPath);
			}
		}

		WriteLine("\t\t}");
		WriteLine("");
	}

	string ToContentPath(string file)
	{
		var contentRoot = Host.ResolvePath("../Content");
		var relative = file.Substring(contentRoot.Length).TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
		return "Content/" + relative.Replace(Path.DirectorySeparatorChar, '/').Replace(Path.AltDirectorySeparatorChar, '/');
	}

	string GenerateConstantName(string fileName)
	{
		var tokens = Regex.Split(fileName, @"[^A-Za-z0-9]+")
			.Where(token => token.Length > 0)
			.Select(ToPascalToken)
			.ToList();

		if (tokens.Count == 0)
			return "_";

		var name = string.Concat(tokens);

		if (IsWorldNumberPattern(tokens))
			name = tokens[0] + tokens[1] + "_" + string.Join("_", tokens.Skip(2));

		if (!char.IsLetter(name, 0) && name[0] != '_')
			name = "_" + name;

		return name;
	}

	bool IsWorldNumberPattern(List<string> tokens)
	{
		return tokens.Count > 2
			&& tokens[0].Equals("World", StringComparison.OrdinalIgnoreCase)
			&& tokens.Skip(1).All(token => Regex.IsMatch(token, @"^\d+$"));
	}

	string ToPascalToken(string token)
	{
		if (token.All(char.IsDigit))
			return token;

		if (token.Length == 1)
			return token.ToUpperInvariant();

		return char.ToUpperInvariant(token[0]) + token.Substring(1);
	}
#>
