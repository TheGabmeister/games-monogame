<?xml version="1.0" encoding="utf-8"?>
<!--
  Score / HUD / banner font. Built by the content pipeline from a system TrueType font
  (FontDescriptionProcessor), loaded as a SpriteFont via Content.Load<SpriteFont>("fonts/main").
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>22</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Bold</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
